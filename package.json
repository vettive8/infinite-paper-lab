{
  "name": "infinite-paper",
  "version": "13.0.0",
  "private": true,
  "type": "module",
  "description": "Infinite Paper — file-backed markdown note canvas",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/",
    "test:browser": "node tools/run-smoke.mjs",
    "test:live": "node tools/run-smoke.mjs --headed",
    "test:all": "npm run test:unit && npm run test:browser"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=20"
  }
}
